# AAGAM Backend Production & Development Configuration
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False

# Comma-separated list of allowed domains
ALLOWED_HOSTS=api.aagam.example.com,localhost,127.0.0.1

# Explicit Frontend Origins (Never wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://krishraj-0821.github.io

# Database Configuration (PostgreSQL in production)
USE_POSTGRES=False
DATABASE_NAME=aagam_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# SIH Demo Evaluation Mode (Visibly labelled demo, strictly isolated)
DEMO_AUTH_MODE=True

# SMS Provider Credentials (Only on backend, NEVER on frontend)
FAST2SMS_API_KEY=
